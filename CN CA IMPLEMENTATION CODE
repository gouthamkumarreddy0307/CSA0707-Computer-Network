############ R-ADM (2911) ############
enable
configure terminal
hostname R-ADM
interface GigabitEthernet0/0
 ip address 192.168.10.206 255.255.255.252
 no shutdown
interface GigabitEthernet0/1
 ip address 192.168.10.161 255.255.255.224
